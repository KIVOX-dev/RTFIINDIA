# Docker / production settings. Copy to .env (never commit the real .env).
NODE_ENV=production
PORT=4100
CLIENT_ORIGIN=https://rtfindia.in
# Used for links in emails, the sitemap and social previews
SITE_URL=https://rtfindia.in
MONGO_URI=mongodb://mongo:27017/rtf

# Signing secrets. The server refuses to start in production without two DIFFERENT strong values.
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
USER_JWT_SECRET=

# First admin, created on first start if it does not exist (change the password in the admin panel afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional email through Brevo (enquiries, member approvals, password resets)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CONTACT_NOTIFY_EMAIL=

# AI (Groq free tier). Fill as many of GROQ_API_KEY_1..GROQ_API_KEY_10 as you have, or use one
# comma separated GROQ_API_KEYS=key1,key2. Empty slots are ignored.
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
