{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND-URL/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-BACKEND-URL/uploads/:path*" },
    { "source": "/sitemap.xml", "destination": "https://YOUR-BACKEND-URL/sitemap.xml" },
    { "source": "/robots.txt", "destination": "https://YOUR-BACKEND-URL/robots.txt" },
    { "source": "/((?!api/|uploads/|assets/|photos/).*)", "destination": "/index.html" }
  ]
}
