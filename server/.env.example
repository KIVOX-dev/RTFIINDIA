# Local development. Copy to server/.env (never commit .env). For Docker/production use the root .env.example.
NODE_ENV=development
PORT=4100
# Leave MONGO_URI empty in development to use a local embedded MongoDB (server/.data).
MONGO_URI=
JWT_SECRET=dev-admin-secret-change-me
USER_JWT_SECRET=dev-member-secret-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
# Set to true once to also load sample prices/news for demos. Never in production.
SEED_DEMO=false
# Optional: email (new enquiries, member approvals, password resets) through Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CONTACT_NOTIFY_EMAIL=
# Optional: AI (Groq). Up to 10 free-tier keys, or one comma separated GROQ_API_KEYS=key1,key2
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_API_KEY_1=
