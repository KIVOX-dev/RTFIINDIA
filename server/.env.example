# Copy to .env and fill in. Never commit .env.
PORT=4100
# Leave MONGO_URI empty in development to use a local embedded MongoDB (server/.data).
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CLIENT_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:5173
# Set to true once to also load sample prices/news for demos. Never in production.
SEED_DEMO=false
# Optional: email new contact messages through Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CONTACT_NOTIFY_EMAIL=
